# Copy this file to `backend/.env` and fill in your Neon values.
# `.env` is git-ignored - never commit it.
#
# Neon shows a URL like:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# Split it into the three variables below. Note the JDBC URL:
#   - starts with  jdbc:postgresql://
#   - contains NO user/password
#   - keeps ?sslmode=require  (drop channel_binding - the JDBC driver doesn't use it)

DATABASE_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
DB_USERNAME=USER
DB_PASSWORD=PASSWORD

# Optional
# DB_POOL_SIZE=5
# SERVER_PORT=8080
